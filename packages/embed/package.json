{
  "name": "openmascot",
  "version": "0.1.0",
  "description": "Pixel mascots for any website: a <Mascot> React component and a one-line script tag.",
  "keywords": [
    "animation",
    "canvas",
    "custom-element",
    "mascot",
    "pixel-art",
    "react",
    "sprite",
    "web-component"
  ],
  "homepage": "https://github.com/DheerajMahra/openmascot#readme",
  "bugs": "https://github.com/DheerajMahra/openmascot/issues",
  "license": "MIT",
  "author": "Dheeraj Mahra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DheerajMahra/openmascot.git",
    "directory": "packages/embed"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "unpkg": "dist/embed.js",
  "jsdelivr": "dist/embed.js",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm build:lib && pnpm build:script",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/add-js-extensions.mjs dist",
    "build:script": "esbuild src/embed.ts --bundle --format=iife --target=es2018 --minify --outfile=dist/embed.js",
    "demo": "pnpm build && echo 'Demo: http://localhost:4311/packages/embed/demo/vanilla/' && python3 -m http.server 4311 --directory ../..",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
