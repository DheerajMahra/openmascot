{
  "name": "openmascot",
  "version": "0.0.1",
  "private": true,
  "description": "Embeddable pixel mascot runtime: one script tag, one JSON file, a living mascot on any page.",
  "scripts": {
    "dev": "pnpm --filter @openmascot/studio dev",
    "dev:site": "pnpm --filter @openmascot/site dev",
    "build": "pnpm --filter @openmascot/studio build",
    "build:site": "pnpm --filter @openmascot/site build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,jsx,json,jsonc,css,md,yml,yaml}": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,mjs,cjs,jsx}": [
      "oxlint"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.6.5"
}
